# ============================================================
# SiTeknik — Environment Variables Reference
# Copy this to .env.local and fill in the values
# NEVER commit .env.local to git
# ============================================================

# --- SUPABASE (REQUIRED for persistent data) ---
# Get these from: https://supabase.com/dashboard/project/kpcbgqrzyxzjrdzskpdq/settings/api

# Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://kpcbgqrzyxzjrdzskpdq.supabase.co

# Anon/Public key (safe to expose — read-only via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role key (SECRET — server-side only, bypasses RLS for writes)
# In Vercel: add this as a non-public env var (no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- AUTHENTICATION ---
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=your_very_long_random_jwt_secret_here

# --- AI (OPTIONAL) ---
# Gemini API Key for AI chatbot responses
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
